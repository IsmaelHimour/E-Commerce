@ShopSphere.Api_HostAddress = http://localhost:5298

GET {{ShopSphere.Api_HostAddress}}/api/health
Accept: application/json

###

GET {{ShopSphere.Api_HostAddress}}/api/products?pageNumber=1&pageSize=12
Accept: application/json

###

GET {{ShopSphere.Api_HostAddress}}/api/products/featured?count=4
Accept: application/json

###

GET {{ShopSphere.Api_HostAddress}}/api/categories
Accept: application/json

###

POST {{ShopSphere.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Portfolio jpp",
  "email": "customer@example.com",
  "password": "Password123!"
}

###

POST {{ShopSphere.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "customer@example.com",
  "password": "Password123!"
}

###

GET {{ShopSphere.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{auth_token}}
Accept: application/json

###

GET {{ShopSphere.Api_HostAddress}}/api/cart
Authorization: Bearer {{auth_token}}
Accept: application/json

###

POST {{ShopSphere.Api_HostAddress}}/api/cart/items
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "productId": 1,
  "quantity": 2
}

###

PUT {{ShopSphere.Api_HostAddress}}/api/cart/items/1
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "quantity": 3
}

###

DELETE {{ShopSphere.Api_HostAddress}}/api/cart/items/1
Authorization: Bearer {{auth_token}}

###

POST {{ShopSphere.Api_HostAddress}}/api/orders
Authorization: Bearer {{auth_token}}
Accept: application/json

###

GET {{ShopSphere.Api_HostAddress}}/api/orders
Authorization: Bearer {{auth_token}}
Accept: application/json

###

GET {{ShopSphere.Api_HostAddress}}/api/orders/1
Authorization: Bearer {{auth_token}}
Accept: application/json

###

GET {{ShopSphere.Api_HostAddress}}/api/orders/admin
Authorization: Bearer {{admin_token}}
Accept: application/json

###

PATCH {{ShopSphere.Api_HostAddress}}/api/orders/admin/1/status
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "status": "Processing"
}

